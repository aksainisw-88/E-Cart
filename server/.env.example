PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SUPER_ADMIN_PANEL_URL=http://localhost:5174
# For each customer API deployment, use that customer's own database URI.
MONGO_URI=mongodb://127.0.0.1:27017/e_mart_customer
# Shared platform database used by all customer API deployments for super-admin accounts and subscriptions.
SUPER_ADMIN_MONGO_URI=
# Generate a unique random value of at least 32 characters for each customer API deployment.
CUSTOMER_DATABASE_ENCRYPTION_KEY=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
